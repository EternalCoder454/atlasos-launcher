# AtlasOS's default pinned apps, in order: one desktop file id per line, or
# preferred://browser, preferred://filemanager, preferred://terminal.
# Apps that aren't installed are skipped. A user's own list is
# ~/.config/atlas-launcher/pinned.list.
preferred://browser
preferred://filemanager
preferred://terminal
net.eterneon.atlas.notepad.desktop
net.eterneon.atlas.store.desktop
net.eterneon.atlas.settings.desktop

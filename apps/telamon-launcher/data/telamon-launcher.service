# Telamon Launcher: the Start menu and search, resident so Meta only shows a
# panel that is already made (docs/DESIGN.md, "Lifetime and idle").
[Unit]
Description=Telamon Launcher
PartOf=graphical-session.target
After=plasma-kwin_wayland.service
Requisite=graphical-session.target

[Service]
Type=dbus
BusName=net.eterneon.telamon.launcher
ExecStart=/usr/bin/telamon-launcher --daemon
Restart=on-failure
RestartSec=500ms
# No NoNewPrivileges, seccomp or RestrictSUIDSGID: the apps it starts would
# inherit them (sudo and pkexec in a terminal opened from the launcher).
OOMScoreAdjust=200
MemoryHigh=300M
Slice=session.slice

[Install]
WantedBy=graphical-session.target
